# Copy to .env and fill in. Never commit the real .env.

# --- Django ------------------------------------------------------------------
# Required unless DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Demo mode (judges/testing: no Termii/Paystack keys needed) --------------
DEMO_MODE=False
DEMO_OTP_CODE=123456
# Only for an intentional demo deployment with DJANGO_DEBUG=False.
DEMO_ALLOW_PROD=False

# --- Paystack ----------------------------------------------------------------
# Live keys start sk_live_ / pk_live_. Test keys start sk_test_.
# Any sk_test_... key still calls the real API, including bank resolution.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Baseten (agentic AI) ----------------------------------------------------
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Muse Voice Transcribe (Meta Model API; separate key from Baseten) -------
MODEL_API_KEY=
ASR_BASE_URL=https://api.meta.ai
ASR_MODEL=muse-voice-transcribe-1.0
VOICE_MAX_BYTES=8388608
VOICE_TIMEOUT=60

# --- WhatsApp (needed from the WhatsApp phase on) -----------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Termii (email OTP) ---------------------------------------------
TERMII_API_KEY=
TERMII_EMAIL_CONFIG_ID=
# Live delivery while DJANGO_DEBUG=True. Without this, DEBUG short-circuits
# to a mock that returns True without emailing anything (plus optional
# LOG_OTP_TO_CONSOLE below). Enable only for live local testing.
TERMII_SEND_IN_DEBUG=False
# Agent/voice request budgets (sync with Procfile web timeout below)
AGENT_MAX_ITERATIONS=8
AGENT_REQUEST_TIMEOUT=60
VOICE_TIMEOUT=60

# --- Email (counterparty invitations; console backend in DEBUG) --------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Trustcrow <no-reply@trustcrow.example>

# --- Tunables ----------------------------------------------------------------
DATABASE_URL=
# Redis etc. supported via CACHE_BACKEND=CACHE_LOCATION, e.g.
# django.core.cache.backends.redis.RedisCache / redis://localhost:6379/0
# CACHE_BACKEND=
# CACHE_LOCATION=
# Sessions stay database-backed even when the cache above is swapped out.
SESSION_ENGINE=django.contrib.sessions.backends.db
# Seconds before an outbound gateway call is abandoned.
GATEWAY_HTTP_TIMEOUT=15
# Minimum gap between OTPs sent to the same address for the same purpose.
OTP_ISSUE_COOLDOWN_SECONDS=60
# Print one-time codes to the log. Leave off outside local development.
LOG_OTP_TO_CONSOLE=False
LOG_LEVEL=INFO

# --- Required when DJANGO_DEBUG=False ---------------------------------------
CSRF_TRUSTED_ORIGINS=https://escrow.example.com
SECURE_SSL_REDIRECT=True
